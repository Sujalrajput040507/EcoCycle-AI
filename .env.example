# EcoCycle AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# Port for the Express server (default: 3000)
PORT=3000

# Google Gemini API key (required for AI image analysis)
# Get yours at https://aistudio.google.com/apikey
# If not set, the server uses a safe fallback estimate instead.
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps Platform Browser API Key (required for interactive map & Places search)
# Get yours at https://console.cloud.google.com/google/maps-apis
# Enable: "Maps JavaScript API" and "Places API"
# Security: Apply HTTP Referrer restrictions in Google Cloud Console
# (e.g. "http://localhost:3000/*" or your production deployment domain)
# If not set, the app gracefully falls back to manual locality selection.
GOOGLE_MAPS_BROWSER_KEY=your_google_maps_browser_key_here

# Razorpay Test Mode Credentials (required for test payment workflow)
# Get yours at https://dashboard.razorpay.com/app/keys in TEST MODE
# Test key IDs always start with "rzp_test_"
# Key Secret must be kept strictly on the server and NEVER exposed to frontend clients
# NEVER use live credentials (rzp_live_) during hackathon development.
RAZORPAY_KEY_ID=your_razorpay_test_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret_here

# Razorpay Webhook Secret (optional in local development; configure for live webhook verification)
# Set up webhooks in Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
# Webhook URL: https://<your-domain>/api/payments/webhook
# Secret: Choose a strong secret or copy the generated webhook secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Phase 10: Authentication & Session Management
# Cryptographically strong secret used to sign session cookies.
# Required in production; defaults to development secret if unset locally.
SESSION_SECRET=your_random_32_character_session_secret_here
NODE_ENV=development
